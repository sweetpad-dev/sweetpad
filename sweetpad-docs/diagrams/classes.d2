direction: right
style.fill: transparent
classes: {
  input: {
    style: {font: mono; font-size: 22; fill: ${input-fill}; stroke: ${input-stroke}; font-color: ${text}; stroke-width: 2; bold: false}
  }
  box: {
    style: {font: mono; font-size: 22; fill: ${box-fill}; stroke: ${box-stroke}; font-color: ${text}; stroke-width: 2; bold: false}
  }
  sweetpad: {
    style: {font: mono; font-size: 22; fill: ${sweetpad-fill}; stroke: ${sweetpad-stroke}; font-color: ${text}; stroke-width: 2; bold: false}
  }
  output: {
    style: {font: mono; font-size: 22; fill: ${output-fill}; stroke: ${output-stroke}; font-color: "#ffffff"; stroke-width: 2; bold: true}
  }
}
(** -> **)[*].style: {stroke: ${edge}; font: mono; font-size: 20; font-color: ${text}; fill: ${label-fill}}
