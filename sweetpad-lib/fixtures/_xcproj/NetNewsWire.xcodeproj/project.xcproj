      ],
      "membership-exceptions": [
        {
          "target": "NetNewsWire iOS Share Extension",
          "inclusions": [
            "AppDefaults.swift",
          ],
        },
      ],
    }, {
      "kind": "group",
      "path": "Intents",
      "children": [
        {
          "kind": "variant-group",
          "name": "Intents.intentdefinition",
          "target-membership": [
            "NetNewsWire iOS Intents Extension/compile-sources",
          ],
          "children": [
            {
              "path": "Base.lproj/Intents.intentdefinition",
            }, {
              "path": "en.lproj/Intents.strings",
            },
          ],
        },
        { "path": "AddWebFeedIntentHandler.swift", "target-membership": [ "NetNewsWire iOS Intents Extension/compile-sources" ] },
      ],
    }, {
      "kind": "folder",
      "path": "Widget",
      "target-membership": [
        "NetNewsWire iOS Widget Extension",
      ],
      "membership-exceptions": [
        {
          "target": "NetNewsWire iOS Widget Extension",
          "exclusions": [
            "Info.plist",
          ],
        },
      ],
    }, {
      "kind": "folder",
      "path": "Shared",
      "target-membership": [
        "NetNewsWire",
        "NetNewsWire-iOS",
      ],
      "membership-exceptions": [
        {
          "target": "NetNewsWire iOS Share Extension",
          "inclusions": [
            "ArticleSpecifier.swift",
            "Assets.swift",
            "UserInfoKey.swift",
          ],
        },
      ],
    },
    { "kind": "folder", "path": "Tests", "target-membership": [ "NetNewsWireTests" ] },
    {
      "kind": "folder",
      "path": "xcconfig",
      "membership-exceptions": [
        {
          "target": "NetNewsWire-iOS",
          "inclusions": [
            "NetNewsWire_iOSwidgetextension_target.xcconfig",
          ],
        },
      ],
    }, {
      "kind": "group",
      "name": "Products",
      "children": [
        { "path": "<PRODUCTS>/.app", "id": "849C64601ED37A5D003D8FC0", "type": "wrapper.application", "index": false },
        { "path": "<PRODUCTS>/.xctest", "id": "849C64711ED37A5D003D8FC0", "type": "wrapper.cfbundle", "index": false },
        { "path": "<PRODUCTS>/.app", "id": "840D617C2029031C009BC708", "type": "wrapper.application", "index": false },
