        { "path": "<PRODUCTS>/.appex", "id": "510C415C24E5CDE3008226FD", "type": "wrapper.app-extension", "index": false, "target-membership": [ { "build-phase": "NetNewsWire/copy/Embed Foundation Extensions", "header-preservation": "remove-on-copy" } ] },
        { "path": "<PRODUCTS>/.appex", "id": "176813F32564BB2C00D98635", "type": "wrapper.app-extension", "index": false, "target-membership": [ { "build-phase": "NetNewsWire-iOS/copy/Embed Foundation Extensions", "header-preservation": "remove-on-copy" } ] },
      ],
