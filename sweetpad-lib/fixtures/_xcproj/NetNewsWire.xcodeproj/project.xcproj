        { "path": "<PRODUCTS>/.appex", "id": "513C5CE6232571C2003D4054", "type": "wrapper.app-extension", "index": false, "target-membership": [ { "build-phase": "NetNewsWire-iOS/copy/Embed Foundation Extensions", "header-preservation": "remove-on-copy" } ] },
        { "path": "<PRODUCTS>/NetNewsWire-iOSTests.xctest", "id": "518B2ED22351B3DD00400001", "type": "wrapper.cfbundle", "index": false },
