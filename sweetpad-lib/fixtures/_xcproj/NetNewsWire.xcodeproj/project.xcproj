      "Base",
    ],
  },
  "packages": [
    {
      "kind": "remote",
      "repository": "https://github.com/Ranchero-Software/Sparkle-Binary.git",
      "version": {
        "up-to-next-major-version": "2.0.0",
      },
    }, {
      "kind": "remote",
      "repository": "https://github.com/microsoft/plcrashreporter.git",
      "version": {
        "up-to-next-major-version": "1.8.1",
      },
