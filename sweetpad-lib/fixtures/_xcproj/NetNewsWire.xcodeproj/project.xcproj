    { "name": "Debug", "file": { "anchor": "xcconfig", "relative-path": "NetNewsWire_project_debug.xcconfig" } },
    { "name": "Release", "file": { "anchor": "xcconfig", "relative-path": "NetNewsWire_project_release.xcconfig" } },
  ],
