             // Always detect ASCII as UTF-8, because we want to prefer Unicode encodings
             return (convertedString, stringEncoding == .ascii ? FileTextEncoding.utf8 : discoveredEncoding)
         }
+        #else
+        // Prefer longer marks: UTF-32 LE starts with the UTF-16 LE mark.
+        let encodings: [FileTextEncoding] = [.utf32be, .utf32le, .utf16be, .utf16le, .utf8]
+        if let discovered = encodings.first(where: { bytes.starts(with: $0.byteOrderMark) }) {
+            guard let string = String(bytes.dropFirst(discovered.byteOrderMark.count), encoding: discovered) else { return nil }
+            return (string, discovered)
+        }
+        // Without a byte-order mark, accept only valid UTF-8.
+        if let string = String(bytes, encoding: .utf8) {
+            return (string, .utf8)
+        }
         #endif

         return nil
