+/// The provisioning inputs `tool` gives for a target: the request goes to its
+/// standard input and the inputs come back on its standard output, each an
+/// XML property list. The tool reports a signing problem in the inputs'
+/// `errors`; a tool that fails is an error too.
+private func externalProvisioningTaskInputs(tool: String, targetGUID: String, sourceData: SWBProvisioningTaskInputsSourceData) -> SWBProvisioningTaskInputs {
+    func failure(_ description: String) -> SWBProvisioningTaskInputs {
+        SWBProvisioningTaskInputs(errors: [["description": description]])
+    }
+    let profileSupport: String
+    switch sourceData.provisioningProfileSupport {
+    case .unsupported: profileSupport = "unsupported"
+    case .optional: profileSupport = "optional"
+    case .required: profileSupport = "required"
+    }
+    var request: [String: PropertyListItem] = [
+        "targetGUID": .plString(targetGUID),
+        "configurationName": .plString(sourceData.configurationName),
+        "provisioningProfileSupport": .plString(profileSupport),
+        "provisioningProfileSpecifier": .plString(sourceData.provisioningProfileSpecifier),
+        "provisioningProfileUUID": .plString(sourceData.provisioningProfileUUID),
+        "provisioningStyle": .plString(sourceData.provisioningStyle == .automatic ? "automatic" : "manual"),
+        "bundleIdentifier": .plString(sourceData.bundleIdentifier),
+        "productTypeEntitlements": .plDict(sourceData.productTypeEntitlements.propertyList),
+        "productTypeIdentifier": .plString(sourceData.productTypeIdentifier),
+        "signingCertificateIdentifier": .plString(sourceData.signingCertificateIdentifier),
+        "signingRequiresTeam": .plBool(sourceData.signingRequiresTeam),
+        "sdkRoot": .plString(sourceData.sdkRoot),
+        "supportsEntitlements": .plBool(sourceData.supportsEntitlements),
+        "wantsBaseEntitlementInjection": .plBool(sourceData.wantsBaseEntitlementInjection),
+        "entitlementsDestination": .plString(sourceData.entitlementsDestination),
+        "localSigningStyle": .plString(sourceData.localSigningStyle),
+        "enableCloudSigning": .plBool(sourceData.enableCloudSigning),
+    ]
+    request["teamID"] = sourceData.teamID.map { .plString($0) }
+    request["projectEntitlementsFile"] = sourceData.projectEntitlementsFile.map { .plString($0) }
+    request["projectEntitlements"] = sourceData.projectEntitlements.map { .plDict($0.propertyList) }
+    request["sdkVariant"] = sourceData.sdkVariant.map { .plString($0) }
+    do {
+        let process = Process()
+        process.executableURL = URL(fileURLWithPath: tool)
+        let input = Pipe()
+        let output = Pipe()
+        let errors = Pipe()
+        process.standardInput = input
+        process.standardOutput = output
+        process.standardError = errors
+        try process.run()
+        input.fileHandleForWriting.write(Data(try PropertyListItem.plDict(request).asBytes(.xml)))
+        try input.fileHandleForWriting.close()
+        let response = output.fileHandleForReading.readDataToEndOfFile()
+        let message = String(decoding: errors.fileHandleForReading.readDataToEndOfFile(), as: UTF8.self)
+        process.waitUntilExit()
+        guard process.terminationStatus == 0 else {
+            return failure("\(tool) failed: \(message)")
+        }
+        guard let inputs = try PropertyList.fromBytes(Array(response)).dictValue else {
+            return failure("\(tool) answered with something other than a dictionary")
+        }
+        func string(_ key: String) -> String? {
+            inputs[key]?.stringValue
+        }
+        func entitlements(_ key: String) throws -> [String: SWBPropertyListItem]? {
+            try inputs[key]?.dictValue.map { try .init($0) }
+        }
+        return SWBProvisioningTaskInputs(
+            identityHash: string("identityHash"),
+            identityName: string("identityName"),
+            profileName: string("profileName"),
+            profileUUID: string("profileUUID"),
+            profilePath: string("profilePath"),
+            designatedRequirements: string("designatedRequirements"),
+            signedEntitlements: try entitlements("signedEntitlements"),
+            simulatedEntitlements: try entitlements("simulatedEntitlements"),
+            appIdentifierPrefix: string("appIdentifierPrefix"),
+            teamIdentifierPrefix: string("teamIdentifierPrefix"),
+            isEnterpriseTeam: inputs["isEnterpriseTeam"]?.boolValue ?? false,
+            errors: (inputs["errors"]?.stringArrayValue ?? []).map { ["description": $0] },
+            warnings: inputs["warnings"]?.stringArrayValue ?? []
+        )
+    } catch {
+        return failure("couldn't get the provisioning inputs from \(tool): \(error)")
+    }
+}
