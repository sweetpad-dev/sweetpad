+    // Clang in Linux Swift 6.4.2 eagerly instantiates every `used` generic
+    // member. These two Optional bridges construct Optional<Optional<T>>,
+    // recursively instantiating themselves without a bound. Preserve DEBUG,
+    // the API, and every other thunk's attributes. Only these bridge helpers
+    // remain lazily emitted, as inline helpers already are.
+    private func compatibleHeader(_ bytes: ByteString) -> ByteString {
+        #if os(Linux)
+        let source = String(decoding: bytes.bytes, as: UTF8.self)
+        let lines = source.split(separator: "\n", omittingEmptySubsequences: false).map { line -> String in
+            let line = String(line)
+            guard line.contains("SWIFT_INLINE_THUNK"),
+                  line.contains("swift::Optional<Optional<T_0_0>>& result"),
+                  line.contains("_forceBridgeFromObjectiveCResult(") || line.contains("_conditionallyBridgeFromObjectiveCResult(") else { return line }
+            return line.replacingOccurrences(of: "SWIFT_INLINE_THUNK", with: "SWIFT_INLINE_PRIVATE_HELPER")
+        }
+        return ByteString(encodingAsUTF8: lines.joined(separator: "\n"))
+        #else
+        return bytes
+        #endif
+    }
+
     override public func performTaskAction(
         _ task: any ExecutableTask,
         dynamicExecutionDelegate: any DynamicTaskExecutionDelegate,
