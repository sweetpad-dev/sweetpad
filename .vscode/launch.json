// A launch configuration that compiles the extension and then opens it inside a new window
// Use IntelliSense to learn about possible attributes.
// Hover to view descriptions of existing attributes.
// For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run Extension",
      "type": "extensionHost",
      "request": "launch",
      "args": ["--extensionDevelopmentPath=${workspaceFolder}/sweetpad-vscode"],
      "outFiles": ["${workspaceFolder}/sweetpad-vscode/out/**/*.js"],
      "preLaunchTask": "npm: watch - sweetpad-vscode"
    },
    {
      "name": "Debug Vitest Tests",
      "type": "node",
      "request": "launch",
      // vitest is hoisted to the workspace root, but its config lives in the extension package.
      "cwd": "${workspaceFolder}/sweetpad-vscode",
      "runtimeArgs": ["--inspect-brk", "${workspaceFolder}/node_modules/.bin/vitest", "run"],
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen"
    }
  ]
}
