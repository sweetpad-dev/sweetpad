<?xml version="1.0" encoding="UTF-8"?>
<document type="com.apple.InterfaceBuilder3.CocoaTouch.XIB" version="3.0" toolsVersion="21701" targetRuntime="iOS.CocoaTouch" useAutolayout="YES" useTraitCollections="YES" useSafeAreas="YES" colorMatched="YES">
    <device id="retina6_1" orientation="portrait" appearance="light" />
    <dependencies>
        <deployment identifier="iOS" />
        <plugIn identifier="com.apple.InterfaceBuilder.IBCocoaTouchPlugin" version="21679" />
        <capability name="Safe area layout guides" minToolsVersion="9.0" />
    </dependencies>
    <objects>
        <placeholder placeholderIdentifier="IBFilesOwner" id="-1" userLabel="File's Owner" />
        <placeholder placeholderIdentifier="IBFirstResponder" id="-2" customClass="UIResponder" />
        <view id="map-lists">
            <rect key="frame" x="0" y="0" width="320" height="480" />
            <subviews>
                <tableView tag="201" id="map-table" dataMode="prototypes" style="plain" rowHeight="44">
                    <rect key="frame" x="0" y="0" width="300" height="120" />
                    <color key="separatorColor" red="1" green="0" blue="0" alpha="1" colorSpace="custom" customColorSpace="sRGB" />
                    <color key="sectionIndexBackgroundColor" red="0" green="1" blue="0" alpha="1" colorSpace="custom" customColorSpace="sRGB" />
                    <color key="sectionIndexTrackingBackgroundColor" red="0" green="0" blue="1" alpha="1" colorSpace="custom" customColorSpace="sRGB" />
                    <inset key="separatorInset" minX="56" minY="0" maxX="0" maxY="0" />
                    <inset key="scrollIndicatorInsets" minX="0" minY="44" maxX="0" maxY="0" />
                </tableView>
                <collectionView tag="202" id="map-collection" dataMode="prototypes">
                    <rect key="frame" x="0" y="121" width="300" height="90" />
                    <collectionViewLayout key="collectionViewLayout" id="map-layout" customClass="CoMapsProbeLayout" />
                </collectionView>
                <searchBar tag="203" id="map-search">
                    <rect key="frame" x="0" y="212" width="300" height="44" />
                    <color key="backgroundColor" red="0" green="0" blue="1" alpha="1" colorSpace="custom" customColorSpace="sRGB" />
                    <color key="barTintColor" red="1" green="0" blue="0" alpha="1" colorSpace="custom" customColorSpace="sRGB" />
                    <textInputTraits key="textInputTraits" autocapitalizationType="words" />
                    <constraints>
                        <constraint firstAttribute="height" constant="55" id="search-height" />
                    </constraints>
                    <variation key="default">
                        <mask key="constraints">
                            <exclude reference="search-height" />
                        </mask>
                    </variation>
                </searchBar>
                <stackView tag="204" id="map-stack">
                    <rect key="frame" x="0" y="257" width="200" height="44" />
                    <color key="backgroundColor" red="0" green="1" blue="0" alpha="1" colorSpace="custom" customColorSpace="sRGB" />
                    <edgeInsets key="layoutMargins" top="1" left="4" bottom="2" right="5" />
                </stackView>
                <wkWebView tag="205" id="map-web">
                    <rect key="frame" x="0" y="302" width="200" height="90" />
                    <color key="backgroundColor" red="1" green="0" blue="0" alpha="1" colorSpace="custom" customColorSpace="sRGB" />
                    <wkWebViewConfiguration key="configuration">
                        <audiovisualMediaTypes key="mediaTypesRequiringUserActionForPlayback" none="YES" />
                        <wkPreferences key="preferences" />
                    </wkWebViewConfiguration>
                </wkWebView>
            </subviews>
        </view>
    </objects>
</document>
