<?xml version="1.0" encoding="UTF-8"?>
<document type="com.apple.InterfaceBuilder3.CocoaTouch.XIB" version="3.0" toolsVersion="21701" targetRuntime="iOS.CocoaTouch" useAutolayout="YES" useTraitCollections="YES" useSafeAreas="YES" colorMatched="YES">
    <device id="retina6_1" orientation="portrait" appearance="light" />
    <dependencies>
        <deployment identifier="iOS" />
        <plugIn identifier="com.apple.InterfaceBuilder.IBCocoaTouchPlugin" version="21679" />
        <capability name="Safe area layout guides" minToolsVersion="9.0" />
    </dependencies>
    <objects>
        <placeholder placeholderIdentifier="IBFilesOwner" id="-1" userLabel="File's Owner" />
        <placeholder placeholderIdentifier="IBFirstResponder" id="-2" customClass="UIResponder" />
        <view id="map-adaptive">
            <rect key="frame" x="0" y="0" width="320" height="480" />
            <subviews>
                <imageView tag="401" image="RouteMarker" translatesAutoresizingMaskIntoConstraints="NO" id="map-arrow">
                    <rect key="frame" x="0" y="0" width="20" height="20" />
                    <color key="backgroundColor" red="0" green="0" blue="1" alpha="1" colorSpace="custom" customColorSpace="sRGB" />
                    <constraints>
                        <constraint firstAttribute="width" constant="20" id="arrow-width" />
                        <constraint firstAttribute="height" constant="20" id="arrow-small-height" />
                        <constraint firstAttribute="height" constant="40" id="arrow-big-height" />
                    </constraints>
                    <variation key="default">
                        <mask key="constraints">
                            <exclude reference="arrow-big-height" />
                        </mask>
                    </variation>
                    <variation key="heightClass=regular-widthClass=regular" image="MapIndicator">
                        <mask key="constraints">
                            <exclude reference="arrow-small-height" />
                            <include reference="arrow-big-height" />
                        </mask>
                    </variation>
                </imageView>
            </subviews>
            <constraints>
                <constraint firstItem="map-arrow" firstAttribute="leading" secondItem="map-adaptive" secondAttribute="leading" constant="4" id="arrow-leading">
                    <variation key="heightClass=regular-widthClass=regular" constant="16" />
                </constraint>
                <constraint firstItem="map-arrow" firstAttribute="top" secondItem="map-adaptive" secondAttribute="top" constant="2" id="arrow-compact" />
                <constraint firstItem="map-arrow" firstAttribute="top" secondItem="map-adaptive" secondAttribute="top" constant="8" id="arrow-regular" />
                <constraint firstItem="map-arrow" firstAttribute="centerX" secondItem="map-adaptive" secondAttribute="centerX" priority="20" id="arrow-wide" />
                <constraint firstItem="map-arrow" firstAttribute="centerY" secondItem="map-adaptive" secondAttribute="centerY" priority="20" id="arrow-wide-tall" />
                <constraint firstItem="map-arrow" firstAttribute="centerY" secondItem="map-adaptive" secondAttribute="centerY" priority="21" id="arrow-wide-short" />
            </constraints>
            <variation key="default">
                <mask key="constraints">
                    <exclude reference="arrow-compact" />
                    <exclude reference="arrow-regular" />
                    <exclude reference="arrow-wide" />
                    <exclude reference="arrow-wide-tall" />
                    <exclude reference="arrow-wide-short" />
                </mask>
            </variation>
            <variation key="heightClass=compact">
                <mask key="constraints">
                    <include reference="arrow-compact" />
                </mask>
            </variation>
            <variation key="heightClass=regular">
                <mask key="constraints">
                    <include reference="arrow-regular" />
                </mask>
            </variation>
            <variation key="widthClass=regular">
                <mask key="constraints">
                    <include reference="arrow-wide" />
                </mask>
            </variation>
            <variation key="heightClass=regular-widthClass=regular">
                <mask key="constraints">
                    <include reference="arrow-wide-tall" />
                </mask>
            </variation>
            <variation key="heightClass=compact-widthClass=regular">
                <mask key="constraints">
                    <include reference="arrow-wide-short" />
                </mask>
            </variation>
        </view>
    </objects>
    <resources>
        <image name="RouteMarker" width="12" height="8" />
        <image name="MapIndicator" width="16" height="12" />
    </resources>
</document>
